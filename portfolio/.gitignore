# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build
/build/

# Testing
/coverage/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
