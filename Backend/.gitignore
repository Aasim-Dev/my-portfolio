# Backend (Node + Express) — the root .gitignore covers most cases.
# This file is a safety net specific to the API service.

# Dependencies
node_modules/

# Environment & secrets — never commit
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*

# Runtime / upload artifacts
uploads/
tmp/
*.pid
*.seed

# Coverage
/coverage/

# OS
.DS_Store
