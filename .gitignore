# ─── Dependencies ────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/registry
jspm_packages/

# ─── Build & generated output ────────────────────────────────
/build/
**/build/
/dist/
.next/
.parcel-cache/
.cache/
.turbo/
.vercel/
.netlify/
.firebase/

# ─── Testing & coverage ──────────────────────────────────────
/coverage/
*.lcov
.nyc_output/

# ─── Environment & secrets ───────────────────────────────────
# Never commit real secrets. .env.example is allowed through.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.sample

# Common secret/key file extensions
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
credentials.json

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Editor / IDE ────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*.swn
.vs/
*.sublime-workspace
*.sublime-project

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Project-specific tooling ────────────────────────────────
.code-review-graph/

# ─── Backend uploads & runtime artifacts ─────────────────────
Backend/uploads/
Backend/tmp/
Backend/.env
# ─── Misc local-only files ───────────────────────────────────
*.local
